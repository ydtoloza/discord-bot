PORT=5001

# Webhook Security (Basic Auth)
# Configura estos mismos en Sonarr/Radarr
WEBHOOK_USERNAME=admin
WEBHOOK_PASSWORD=cambiame

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# Ventana deslizante de agregación de episodios (ms): cada webhook del mismo
# evento/serie reinicia el contador y el embed sale al vencer.
# Subirla agrupa más episodios por mensaje (ej. 60000 = 60 s).
AGGREGATION_DELAY_MS=10000

# Optional TMDB lookup for series package descriptions.
TMDB_API_KEY=your-tmdb-api-key
TMDB_LANGUAGE=es-ES
TMDB_CACHE_TTL_MINUTES=1440
